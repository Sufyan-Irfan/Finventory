<%# views/invoices/list.ejs — no HTML wrapper, expressLayouts handles it %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0"><i class="bi bi-receipt me-2"></i>Invoices</h4>
  <a href="/invoices/add" class="btn btn-primary btn-sm">
    <i class="bi bi-plus-lg me-1"></i>New Invoice
  </a>
</div>

<% if (success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show py-2">
    <%- success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>
<% if (error && error.length) { %>
  <div class="alert alert-danger alert-dismissible fade show py-2">
    <%- error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover table-sm align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th>Bill No.</th>
            <th>Date</th>
            <th>Vehicle</th>
            <th>Seller</th>
            <th>Buyer</th>
            <th class="text-end">Bags</th>
            <th class="text-end">S.Rate</th>
            <th class="text-end">B.Rate</th>
            <th class="text-end">Seller Net</th>
            <th class="text-end">Buyer Net</th>
            <th class="text-center">Diff</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!invoices.length) { %>
            <tr>
              <td colspan="12" class="text-center text-muted py-4">
                No invoices found.
                <a href="/invoices/add">Add first invoice</a>
              </td>
            </tr>
          <% } %>

          <% invoices.forEach(inv => { %>
            <% const diff = Number(inv.diff || 0); %>
            <tr>
              <td><strong><%= inv.bill_no %></strong></td>
              <td class="text-nowrap"><%= inv.bill_date %></td>
              <td><%= inv.vehicle_no || '—' %></td>
              <td><small class="text-muted"><%= inv.seller_code || '—' %></small></td>
              <td><small class="text-muted"><%= inv.buyer_code  || '—' %></small></td>
              <td class="text-end"><%= Number(inv.bags||0).toLocaleString('en-PK') %></td>
              <td class="text-end"><%= Number(inv.seller_rate||0).toFixed(4) %></td>
              <td class="text-end"><%= Number(inv.buyer_rate||0).toFixed(4)  %></td>
              <td class="text-end"><strong><%= fmt(inv.seller_net) %></strong></td>
              <td class="text-end"><strong><%= fmt(inv.buyer_net)  %></strong></td>
              <td class="text-center">
                <span class="badge <%= diff === 0 ? 'bg-success' : 'bg-warning text-dark' %>">
                  <%= Number(diff).toLocaleString('en-PK') %>
                </span>
              </td>
              <td class="text-center" style="white-space:nowrap;">
                <a href="/invoices/edit/<%= inv.id %>"
                   class="btn btn-outline-secondary btn-sm py-0 px-2">
                  <i class="bi bi-pencil"></i>
                </a>
                <form action="/invoices/delete/<%= inv.id %>"
                      method="POST" class="d-inline"
                      onsubmit="return confirm('Delete Bill #<%= inv.bill_no %>?')">
                  <button class="btn btn-outline-danger btn-sm py-0 px-2">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
