<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Company Features</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container-fluid py-4 px-3 px-md-4">
  <h4 class="fw-bold mb-3">⚙️ Company Feature Flags</h4>

  <% if (error && error.length) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>
  <% if (success && success.length) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <div class="row g-3">
    <% companies.forEach(c => { %>
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card">
        <div class="card-header fw-bold"><%= c.company_code %></div>
        <div class="card-body">
          <form action="/admin/features/update" method="POST">
            <input type="hidden" name="company_code" value="<%= c.company_code %>">
            <% availableFeatures.forEach(f => { %>
              <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox"
                  name="<%= f.key %>" id="<%= c.company_code %>_<%= f.key %>"
                  <%= (featureMap[c.company_code] || {})[f.key] ? 'checked' : '' %>>
                <label class="form-check-label" for="<%= c.company_code %>_<%= f.key %>">
                  <%= f.label %>
                </label>
              </div>
            <% }) %>
            <button class="btn btn-sm btn-primary mt-2">Save</button>
          </form>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
</div>
</body>
</html>