<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Access Control</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body { background: #f4f6f8; }
    @media (max-width: 576px) {
      th, td { font-size: 12.5px; }
      .btn-sm { font-size: 0.72rem; }
    }
  </style>
</head>
<body>
<div class="container-fluid py-4 px-3 px-md-4">
  <h4 class="fw-bold mb-3"><i class="bi bi-person-gear"></i> User Access Control</h4>

  <% if (error && error.length) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>
  <% if (success && success.length) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <!-- ===== ADD USER ===== -->
  <div class="card mb-4">
    <div class="card-header bg-primary text-white fw-semibold">
      <i class="bi bi-person-plus"></i> Add New User
    </div>
    <div class="card-body">
      <form action="/company-admin/add-user" method="POST" class="row g-3">
        <div class="col-12 col-sm-6 col-md-4">
          <label class="form-label">Username</label>
          <input type="text" name="username" class="form-control" required placeholder="Enter username">
        </div>
        <div class="col-12 col-sm-6 col-md-4">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" required placeholder="Enter password">
        </div>
        <div class="col-6 col-sm-4 col-md-2">
          <label class="form-label">Role</label>
          <select name="company_role" class="form-select">
            <option value="user">User</option>
            <option value="company_admin">Company Admin</option>
          </select>
        </div>
        <div class="col-6 col-sm-4 col-md-2 d-flex align-items-end">
          <button class="btn btn-success w-100">Add User</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ===== USERS LIST ===== -->
  <% if (companyUsers.length === 0) { %>
    <div class="alert alert-info">No other users in your company yet.</div>
  <% } %>

  <% companyUsers.forEach(u => { %>
  <div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-person-circle text-secondary"></i>
        <span class="fw-semibold"><%= u.username %></span>
        <span class="badge <%= u.company_role === 'company_admin' ? 'bg-warning text-dark' : 'bg-secondary' %>">
          <%= u.company_role === 'company_admin' ? 'Company Admin' : 'User' %>
        </span>
      </div>
      <form action="/company-admin/delete-user/<%= u.id %>" method="POST"
            onsubmit="return confirm('Delete user <%= u.username %>?')">
        <button class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> Delete</button>
      </form>
    </div>
    <div class="card-body">
      <form action="/company-admin/update-permissions/<%= u.id %>" method="POST">

        <div class="mb-3">
          <label class="form-label fw-semibold small text-muted">ROLE</label>
          <select name="company_role" class="form-select form-select-sm" style="width:180px;">
            <option value="user"          <%= u.company_role === 'user'          ? 'selected' : '' %>>User</option>
            <option value="company_admin" <%= u.company_role === 'company_admin' ? 'selected' : '' %>>Company Admin</option>
          </select>
        </div>

        <label class="form-label fw-semibold small text-muted">PERMISSIONS</label>
        <div class="row g-2 mb-3">
          <% allPermissions.forEach(p => { %>
            <div class="col-6 col-md-3">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox"
                  name="<%= p.key %>" id="<%= u.id %>_<%= p.key %>"
                  <%= u.permissions[p.key] ? 'checked' : '' %>>
                <label class="form-check-label small" for="<%= u.id %>_<%= p.key %>">
                  <%= p.label %>
                </label>
              </div>
            </div>
          <% }) %>
        </div>

        <button class="btn btn-primary btn-sm">
          <i class="bi bi-save"></i> Save Changes
        </button>
      </form>
    </div>
  </div>
  <% }) %>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
